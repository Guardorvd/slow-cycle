{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "slow-cycle.baseline/1 with explicit A3 representation and A4 session semantics",
  "type": "object",
  "required": ["schema_version", "representation", "baseline_id", "runtime_base_revision", "campaign_freeze_revision", "campaign_definition_digest", "ledger_head_sha256", "run_refs", "runtime_identity_proof", "environment", "seed_matrix", "road_identity", "determinism", "rider", "branch", "streaming", "performance", "memory", "vulkan", "leaks", "known_failures", "known_incomplete", "accepted_gaps", "C10", "C12", "runtime_acceptance", "overall_baseline_status", "artifact_manifest", "freeze_receipt", "reporting_source"],
  "properties": {
    "schema_version": {"const": "slow-cycle.baseline/1"},
    "representation": {"enum": ["full-external/1", "compact-repository/1"]},
    "C10": {"const": "OPEN"},
    "C12": {"const": "OPEN"},
    "runtime_acceptance": {"const": "INCOMPLETE"},
    "overall_baseline_status": {"enum": ["CAPTURED", "CAPTURED_WITH_ACCEPTED_GAPS", "AWAITING_HUMAN_GAP_DECISION", "NOT_COMPLETED", "INVALID"]},
    "run_refs": {"type": "array", "items": {"type": "object", "required": ["attempt_ordinal", "attempt_id", "suite_id", "phase", "round", "seed_config", "configuration", "observer_mode", "statistics_role", "q1_run_id", "q1_check_relpath", "q1_result", "q1_reason_code", "q1_reasons", "evidence_status", "directory_digest", "q1_result_json_sha256", "retry_of"]}},
    "full_external_report": {"type": "object", "required": ["schema_version", "representation", "relpath", "bytes", "sha256", "baseline_id", "campaign_freeze_revision"], "properties": {"representation": {"const": "full-external/1"}, "relpath": {"const": "aggregate/baseline.json"}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "artifact_manifest": {"type": "object", "required": ["payload_evidence_digest", "closure_metadata_paths", "excluded_from_payload"], "properties": {"payload_evidence_digest": {"type": "object", "required": ["artifact_root_digest", "relpath", "bytes", "files"]}, "closure_metadata_paths": {"const": ["aggregate/artifact_index_full.txt", "SHA256SUMS", "aggregate/baseline.json"]}, "excluded_from_payload": {"const": ["aggregate/artifact_index_full.txt", "SHA256SUMS", "aggregate/baseline.json", "aggregate/repository_artifact_index.txt"]}}},
    "freeze_receipt": {"type": "object", "required": ["relpath", "bytes", "sha256", "schema"]}
  },
  "allOf": [
    {"required": ["session_timing"], "properties": {"session_timing": {"type": "object", "required": ["label", "equality_claim", "field"], "properties": {"label": {"const": "REPEATABILITY_OBSERVATION"}, "equality_claim": {"const": false}, "field": {"const": "physics_tick"}}}, "superseded_RI_SESSION": {"type": "object", "required": ["status", "defect", "receipt", "record"], "properties": {"status": {"const": "SUPERSEDED_BY_A4"}, "receipt": {"type": "object", "required": ["relpath", "bytes", "sha256"]}}}}},
    {"if": {"properties": {"representation": {"const": "compact-repository/1"}}}, "then": {"required": ["full_external_report", "run_binding_details"], "properties": {"run_binding_details": {"$ref": "#/$defs/detailReference"}, "road_identity": {"type": "object", "required": ["attempt_count", "RI_CAP_values", "detail"], "properties": {"detail": {"$ref": "#/$defs/detailReference"}}}, "session_timing": {"type": "object", "required": ["value_count", "comparison_count", "findings", "detail"], "properties": {"detail": {"$ref": "#/$defs/detailReference"}}}, "determinism": {"type": "object", "required": ["findings", "comparison_count", "detail"], "properties": {"detail": {"$ref": "#/$defs/detailReference"}}}, "branch": {"$ref": "#/$defs/summary"}, "streaming": {"$ref": "#/$defs/summary"}}}, "else": {"properties": {"road_identity": {"type": "object", "additionalProperties": {"type": "object", "properties": {"RI-SESSION": {"type": "array", "items": {"$ref": "#/$defs/sessionComponents"}}}}}, "session_timing": {"required": ["values", "comparisons"]}}}}
  ],
  "$defs": {
    "sessionComponents": {"type": "object", "required": ["checkpoints", "decisions", "timing", "sha256", "status", "effective_seed", "attempt_id", "ordinal", "q1_run_id", "source_relpath", "source_sha256"], "properties": {"checkpoints": {"type": "array", "items": {"type": "object", "required": ["label", "signature"], "properties": {"label": {"enum": ["opening", "selected_arm"]}, "signature": {"type": "string"}}}}, "decisions": {"type": "array", "items": {"type": "object", "required": ["fork_id", "choice", "selected_branch_id", "selected_seed"], "additionalProperties": false, "properties": {"fork_id": {}, "choice": {}, "selected_branch_id": {}, "selected_seed": {}}}}, "timing": {"type": "object", "required": ["label", "physics_tick", "status"], "properties": {"label": {"const": "REPEATABILITY_OBSERVATION"}, "physics_tick": {"type": "array"}}}, "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "detailReference": {"type": "object", "required": ["record_ref", "json_pointer"], "additionalProperties": false, "properties": {"record_ref": {"const": "full_external_report"}, "json_pointer": {"type": "string", "pattern": "^/"}}},
    "summary": {"type": "object", "required": ["attempt_or_observation_count", "detail"], "properties": {"attempt_or_observation_count": {"type": "integer", "minimum": 0}, "detail": {"$ref": "#/$defs/detailReference"}}}
  }
}
