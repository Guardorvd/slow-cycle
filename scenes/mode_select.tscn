[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/ui/mode_select.gd" id="1_script"]

[sub_resource type="StyleBoxFlat" id="StyleBox_Bg"]
bg_color = Color(0.08, 0.10, 0.09, 1)

[sub_resource type="StyleBoxFlat" id="StyleBox_BtnNormal"]
